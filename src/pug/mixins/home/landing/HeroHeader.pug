mixin HeroHeader
  section.py-5.overflow-hidden.bg-light#home
    .container
      .row.flex-center.min-vh-75
        .col-md-7.col-lg-6.py-8.text-md-start.text-center.order-1.order-md-0
          h1.display-1.fs-md-5.fs-lg-6.fs-xl-8.text-black.fw-bolder.mb-4 One Kitchen. Multiple Cravings.
          p.lead.text-muted.mb-5 Order from our unique virtual brands, all cooked in one premium cloud kitchen and delivered in one single order.
          .card.shadow-sm.border-0.rounded-pill.p-2.w-xxl-100
            .card-body.p-0
              form.row.gx-0.align-items-center
                .col
                  .input-group-icon
                    i.fas.fa-map-marker-alt.text-primary.input-box-icon.ms-3
                    label.visually-hidden(for='inputDelivery') Address
                    input.form-control.border-0.shadow-none.ps-5.py-3.rounded-pill(type='text' placeholder='Enter delivery address' style='font-size: 1.1rem;')
                .col-auto
                  button.btn.btn-primary.rounded-pill.py-3.px-4(type='submit') 
                    i.fas.fa-arrow-right
  
        .col-md-5.col-lg-6.order-0.order-md-1.mt-8.mt-md-0
          a(href='#!').img-landing-banner
            img.img-fluid.rounded-3(src=`${CWD}assets/img/gallery/hero_cloud_kitchen.png` alt='hero-header' style='box-shadow: 0 10px 40px rgba(0,0,0,0.1);')