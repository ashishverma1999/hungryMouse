mixin FeaturedRestaurant(config)
  .col-sm-6.col-md-4.col-lg-3.h-100.mb-5
    a(href='#!' style='text-decoration: none; color: inherit;').card.border-0.shadow-none.h-100.hover-top
      img.img-fluid.rounded-4.mb-3(src=`${CWD}assets/img/gallery/${config.image}` alt='...' style='object-fit: cover; height: 180px; width: 100%;')
      .card-body.p-0
        .d-flex.justify-content-between.align-items-start.mb-1
          h5.mb-0.fw-bold=config.name 
          span.badge.bg-light.text-dark.fs--1.rounded-pill
            i.fas.fa-star.text-warning.me-1
            | #{config.rating}
        p.text-muted.mb-1.fs--1
          span.text-dark.fw-bold $0 delivery fee
          span.mx-2 &bull;
          | #{config.time} mins
        p.text-muted.fs--1.mb-0 Virtual Brand &bull; #{config.desc}

mixin  FeaturedRestaurants
  section.py-5
    .container
      .row.mb-4
        .col-12
          h3.fw-bold.fs-4.fs-lg-5.lh-sm Our Virtual Brands
      .row.gx-4.gy-4 
        each item in restaurants
          +FeaturedRestaurant(item)